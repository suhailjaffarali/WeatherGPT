# ============================================================
# WeatherGPT Backend — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ============================================================

# --- AI Provider API Keys (at least GROQ_API_KEY recommended) ---
GROQ_API_KEY=
HF_TOKEN=
GEMINI_API_KEY=

# --- Weather Data ---
# OpenWeatherMap One Call 3.0 — required for /api/weather
OWM_API_KEY=

# --- Security ---
# Optional. When set, all endpoints require "X-API-Key: <value>" header.
APP_API_KEY=

# CORS — comma-separated origins. Use * for open access (disables credentials).
ALLOWED_ORIGINS=*

# --- Model Selection (optional overrides) ---
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
HF_MODEL=Qwen/Qwen2.5-72B-Instruct
GEMINI_MODEL=gemini-2.0-flash

# --- Storage ---
AUDIO_OUT_DIR=./audio_cache
