{
  "expo": {
    "name": "WeatherGPT",
    "slug": "weathergpt",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "permissions": [
        "RECORD_AUDIO",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow WeatherGPT to access your microphone for spoken farm weather advisories.",
          "recordAudioAndroid": true
        }
      ]
    ]
  }
}
